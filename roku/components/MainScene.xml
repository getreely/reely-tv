<?xml version="1.0" encoding="utf-8"?>
<!-- Reely: signing in, finding the server, then the tabs and their pages, the poster menu
     and the player, as the Fire TV app has them. -->
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/plex.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/xtream.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/reely.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/extras.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/ScreenKit.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Oops.brs" />
  <children>
    <Rectangle id="ground" width="1920" height="1080" color="0x08090BFF" />

    <Group id="signIn" visible="false">
      <!-- The mark, as on Fire TV: the "r" and the bar under it. -->
      <Poster id="signInMark" uri="pkg:/images/mark_white.png" blendColor="0x2E6BFFFF" width="29" height="60" translation="[96, 40]" />
      <Label id="signInTitle" width="1920" translation="[0, 330]" horizAlign="center" color="0xF2F4F7FF" text="Sign in to watch your library" />
      <Label id="signInHint" width="1920" translation="[0, 420]" horizAlign="center" color="0xB3BAC4FF" wrap="true" />
      <Label id="code" width="1920" translation="[0, 500]" horizAlign="center" color="0xF2F4F7FF" />
      <Label id="signInNote" width="1920" translation="[0, 640]" horizAlign="center" color="0x7F8792FF" />
    </Group>

    <Group id="shell" visible="false">
      <!-- The tabs drawn after the screens, so a page's picture can fill the screen behind them. -->
      <Group id="screens" translation="[0, 130]" />
      <NavBar id="nav" />
    </Group>

    <PlayerView id="player" visible="false" />
    <LiveView id="liveView" visible="false" />
    <Group id="overlays" />
    <Label id="status" translation="[96, 1010]" width="1700" color="0xFF6B6BFF" wrap="true" />
    <Timer id="claimTimer" duration="2" repeat="true" />
    <Timer id="retryTimer" duration="30" repeat="false" />
    <Timer id="reminderTimer" duration="30" repeat="true" />
    <!-- The scene saying it's alive, to the watchdog. -->
    <Timer id="beatTimer" duration="0.5" repeat="true" />
    <!-- How long what went wrong last time is said for. -->
    <Timer id="saidTimer" duration="45" repeat="false" />
  </children>
</component>
