<?xml version="1.0" encoding="utf-8"?>
<!-- A poster in a row: its picture, the new-episodes count in a circle that stays one
     size, how far through it is, and its name. -->
<component name="PosterItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="show" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="focusPercent" type="float" onChange="focusChanged" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PosterItem.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/plex.brs" />
  <children>
    <!-- The cursor: an outline round the picture alone, so the name below stays readable. -->
    <Rectangle id="ring" color="0xF2F4F7FF" visible="false" />
    <Rectangle id="frame" color="0x1F2329FF" />
    <!-- A person's photo is round; a title's picture square-cornered. -->
    <MaskGroup id="mask">
      <Poster id="art" loadDisplayMode="scaleToZoom" />
    </MaskGroup>
    <Poster id="tick" uri="pkg:/images/badge.png" width="40" height="40" blendColor="0x08090BCC" visible="false" />
    <Label id="tickMark" text="✓" width="40" height="40" horizAlign="center" vertAlign="center" color="0xF2F4F7FF" visible="false" />
    <Label id="tag" color="0xF2F4F7FF" visible="false" />
    <Rectangle id="track" color="0x08090B99" visible="false" />
    <Rectangle id="progress" color="0x2E6BFFFF" visible="false" />
    <Poster id="badge" uri="pkg:/images/badge.png" width="44" height="44" visible="false" />
    <Label id="count" width="44" height="44" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" visible="false" />
    <Label id="title" color="0xB3BAC4FF" />
    <Label id="sub" color="0x7F8792FF" />
  </children>
</component>
