<?xml version="1.0" encoding="utf-8"?>
<!-- A channel in the list: its logo, number and name, what's on with how far through it
     is, and what's next. -->
<component name="ChannelItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="show" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="focusPercent" type="float" onChange="focusChanged" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/parts/ChannelItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Fonts.brs" />
  <children>
    <Poster id="back" uri="pkg:/images/card.9.png" blendColor="0x15171BFF" />
    <Poster id="ring" uri="pkg:/images/ring.9.png" blendColor="0xF2F4F7FF" visible="false" />
    <Rectangle id="logoBack" translation="[16, 14]" width="136" height="76" color="0x1F2329FF" />
    <Poster id="logo" translation="[20, 18]" width="128" height="68" loadDisplayMode="scaleToFit" />
    <Label id="initials" translation="[16, 14]" width="136" height="76" horizAlign="center" vertAlign="center" color="0xB3BAC4FF" />
    <Label id="name" translation="[176, 10]" color="0xF2F4F7FF" />
    <Label id="now" translation="[176, 50]" color="0xB3BAC4FF" />
    <Rectangle id="track" translation="[176, 88]" height="4" color="0x2B3038FF" visible="false" />
    <Rectangle id="bar" translation="[176, 88]" height="4" color="0x2E6BFFFF" visible="false" />
    <Label id="next" color="0x7F8792FF" />
  </children>
</component>
