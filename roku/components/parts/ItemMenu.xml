<?xml version="1.0" encoding="utf-8"?>
<!-- A poster's menu, as the Fire TV's (there from holding OK, here from the Options key):
     down the right with the title's picture at the top. -->
<component name="ItemMenu" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="build" />
    <field id="inContinueWatching" type="boolean" />
    <!-- What was chosen: play, restart, next, watched, unwatched, details, remove; or "" for Back. -->
    <field id="chosen" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/parts/ItemMenu.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/ScreenKit.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x08090B99" />
    <Rectangle translation="[1340, 0]" width="580" height="1080" color="0x15171BFF" />
    <Poster id="art" translation="[1340, 0]" width="580" height="326" loadDisplayMode="scaleToZoom" />
    <Label id="title" translation="[1380, 350]" width="500" color="0xF2F4F7FF" wrap="true" maxLines="2" />
    <Label id="sub" translation="[1380, 450]" width="500" color="0xB3BAC4FF" />
    <LabelList id="list" translation="[1380, 510]" itemSize="[480, 64]" numRows="8" vertFocusAnimationStyle="floatingFocus"
      focusBitmapUri="pkg:/images/pill.9.png" color="0xF2F4F7FF" focusedColor="0x08090BFF" />
  </children>
</component>
