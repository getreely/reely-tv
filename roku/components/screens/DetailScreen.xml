<?xml version="1.0" encoding="utf-8"?>
<!-- A title's page, as on the Fire TV: play, resume or restart, watched, the Watchlist,
     the trailer, which copy; a show's seasons and episodes, opening where it's up to;
     the cast, and more like it. -->
<component name="DetailScreen" extends="Group">
  <interface>
    <field id="route" type="assocarray" onChange="open" />
    <field id="go" type="assocarray" alwaysNotify="true" />
    <field id="play" type="assocarray" alwaysNotify="true" />
    <field id="menu" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="focusIn" />
    <!-- Back from the player: the page again, on the episode just watched. -->
    <field id="refresh" type="assocarray" alwaysNotify="true" onChange="refreshed" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/DetailScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Listen.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/ScreenKit.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Oops.brs" />
  <children>
    <!-- As the Fire TV's: the title's picture behind the whole screen, fading into the black
         at the left and the bottom; the screens sit 130 down, under the tabs. -->
    <Poster id="backdrop" translation="[0, -130]" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToZoom" />
    <Poster uri="pkg:/images/fade_left.png" translation="[0, -130]" width="1920" height="1080" />
    <Poster uri="pkg:/images/fade_bottom.png" translation="[0, -130]" width="1920" height="1080" />
    <Group id="page">
      <Label id="title" translation="[96, 0]" width="1500" color="0xF2F4F7FF" />
      <!-- The scores as outlined badges, the details, then the quality badges. -->
      <Group id="facts" translation="[96, 96]" />
      <Label id="upNext" translation="[96, 152]" width="1500" color="0xF2F4F7FF" />
      <Label id="summary" translation="[96, 198]" width="1150" wrap="true" maxLines="3" lineSpacing="6" color="0xB3BAC4FF" />
      <RoundRow id="actions" translation="[70, 330]" wideFirst="true" />
      <PillRow id="versions" translation="[96, 490]" fontSize="22" visible="false" />
      <Label id="note" translation="[96, 490]" width="1500" color="0xFF6B6BFF" />
      <PillRow id="seasons" translation="[96, 490]" fontSize="24" visible="false" />
      <!-- The season's episodes as a row of pictures. -->
      <RowList id="episodes" translation="[96, 560]" itemComponentName="PosterItem" numRows="1"
        itemSize="[1728, 380]" rowItemSize="[[427, 304]]" rowItemSpacing="[[24, 0]]" showRowLabel="[true]" rowLabelColor="0xF2F4F7FF"
        rowLabelOffset="[[0, 14]]" rowFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" visible="false" />
      <RowList id="rows" translation="[96, 980]" itemComponentName="PosterItem" numRows="2"
        rowItemSpacing="[[24, 0]]" itemSpacing="[0, 44]" showRowLabel="[true]" rowLabelColor="0xF2F4F7FF"
        rowLabelOffset="[[0, 14]]" rowFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" />
    </Group>
  </children>
</component>
