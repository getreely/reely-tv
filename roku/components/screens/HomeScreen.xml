<?xml version="1.0" encoding="utf-8"?>
<!-- Home: Continue Watching, new episodes and films, the Watchlist, playlists. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="route" type="assocarray" />
    <field id="go" type="assocarray" alwaysNotify="true" />
    <field id="menu" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="focusIn" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Listen.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/ScreenKit.brs" />
  <children>
    <HeroView id="hero" fallback="Home" />
    <!-- A request that's arrived: what it is, Watch and Dismiss, above the rows. -->
    <Group id="ready" visible="false">
      <Poster uri="pkg:/images/card.9.png" blendColor="0x15171BFF" translation="[96, 10]" width="1728" height="150" />
      <Poster id="readyArt" translation="[116, 22]" width="84" height="126" loadDisplayMode="scaleToZoom" />
      <Label id="readyName" translation="[224, 30]" width="1000" color="0xF2F4F7FF" />
      <Label id="readyFacts" translation="[224, 82]" width="1000" color="0xB3BAC4FF" />
      <PillRow id="readyActions" translation="[1340, 50]" fontSize="26" />
    </Group>
    <Label id="note" translation="[96, 40]" width="1700" color="0xFF6B6BFF" />
    <RowList id="rows" translation="[96, 30]" itemComponentName="PosterItem" numRows="2"
      rowItemSpacing="[[24, 0]]" itemSpacing="[0, 44]" showRowLabel="[true]" rowLabelColor="0xF2F4F7FF"
      rowLabelOffset="[[0, 14]]" rowFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" />
  </children>
</component>
