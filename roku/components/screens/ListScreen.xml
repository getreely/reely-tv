<?xml version="1.0" encoding="utf-8"?>
<!-- Everything someone's in, a collection's titles, or a playlist with Play and Shuffle. -->
<component name="ListScreen" extends="Group">
  <interface>
    <field id="route" type="assocarray" onChange="open" />
    <field id="go" type="assocarray" alwaysNotify="true" />
    <field id="play" type="assocarray" alwaysNotify="true" />
    <field id="menu" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="focusIn" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/ListScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/ScreenKit.brs" />
  <children>
    <Label id="title" translation="[96, 10]" width="1600" color="0xF5F2F0FF" />
    <Label id="count" translation="[96, 90]" width="1600" color="0xB9B4B1FF" />
    <PillRow id="actions" translation="[96, 140]" fontSize="26" visible="false" />
    <MarkupGrid id="grid" translation="[96, 160]" itemComponentName="PosterItem" itemSize="[240, 424]"
      itemSpacing="[24, 36]" numColumns="6" numRows="2" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
  </children>
</component>
