<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV, as the other apps have it: signing in to the provider (a server login or an
     M3U playlist); then categories, channels with what's on, and the guide as a grid. -->
<component name="LiveScreen" extends="Group">
  <interface>
    <field id="route" type="assocarray" onChange="open" />
    <field id="go" type="assocarray" alwaysNotify="true" />
    <field id="menu" type="assocarray" alwaysNotify="true" />
    <!-- A channel to watch: { channels, index, catchUp }. -->
    <field id="watch" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="focusIn" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/LiveScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/plex.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/xtream.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Listen.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/ScreenKit.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Oops.brs" />
  <children>
    <Group id="signIn" visible="false">
      <Label id="signInTitle" translation="[0, 40]" width="1920" horizAlign="center" color="0xF2F4F7FF" text="Watch live TV from your provider" />
      <Label id="signInNote" translation="[0, 120]" width="1920" horizAlign="center" color="0xB3BAC4FF"
        text="Sign in with the details your IPTV provider gave you. Reely doesn't provide channels." />
      <PillRow id="modes" translation="[660, 190]" fontSize="26" />
      <Label id="signInError" translation="[0, 280]" width="1920" horizAlign="center" color="0xFF6B6BFF" wrap="true" />
      <LabelList id="form" translation="[560, 340]" itemSize="[800, 76]" numRows="6" vertFocusAnimationStyle="floatingFocus"
        focusBitmapUri="pkg:/images/pill.9.png" color="0xF2F4F7FF" focusedColor="0x08090BFF" />
    </Group>

    <Group id="live" visible="false">
      <PillRow id="views" translation="[96, 0]" fontSize="26" />
      <Label id="note" translation="[540, 110]" width="1280" color="0xB3BAC4FF" wrap="true" />
      <LabelList id="categories" translation="[96, 90]" itemSize="[400, 60]" numRows="13" vertFocusAnimationStyle="floatingFocus"
        focusBitmapUri="pkg:/images/pill.9.png" color="0xF2F4F7FF" focusedColor="0x08090BFF" />
      <MarkupList id="channels" translation="[540, 90]" itemComponentName="ChannelItem" itemSize="[1284, 104]" itemSpacing="[0, 12]"
        numRows="7" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
      <!-- The guide as the Fire TV's: the programme in focus above, channels as tiles, the
           programmes as soft blocks, the one in focus in the accent, a line for now. -->
      <Group id="guide" visible="false">
        <Label id="aboutCategory" translation="[96, 80]" width="1300" color="0x7F8792FF" />
        <Label id="about" translation="[96, 112]" width="1300" color="0xF2F4F7FF" />
        <Label id="aboutFacts" translation="[96, 168]" width="1300" color="0xB3BAC4FF" />
        <Label id="aboutText" translation="[96, 206]" width="1240" height="70" wrap="true" maxLines="2" color="0xB3BAC4FF" />
        <!-- The highlighted channel, playing, a moment after the cursor stops on it. -->
        <Group id="previewBox" translation="[1420, 60]" visible="false">
          <Rectangle translation="[-2, -2]" width="408" height="229" color="0x2B3038FF" />
          <Rectangle width="404" height="225" color="0x000000FF" />
          <Video id="preview" width="404" height="225" enableUI="false" mute="false" />
        </Group>
        <TimeGrid id="grid" translation="[96, 290]" numRows="6" duration="9000" channelInfoWidth="240" infoGridGap="12"
          rowHeight="[96]" itemSpacing="[0, 12]" channelInfoAlignment="center"
          channelInfoBackgroundBitmapUri="pkg:/images/guide_channel.9.png"
          programBackgroundBitmapUri="pkg:/images/guide_cell.9.png" focusBitmapUri="pkg:/images/guide_focus.9.png"
          programTitleColor="0xF2F4F7FF" programTitleFocusedColor="0x08090BFF" channelInfoTextColor="0xF2F4F7FF"
          timeLabelColor="0x7F8792FF" nowBarBitmapUri="pkg:/images/white.png" nowBarBlendColor="0xF2F4F7CC" nowBarWidth="3"
          programHorizMargin="20" />
      </Group>
    </Group>
  </children>
</component>
