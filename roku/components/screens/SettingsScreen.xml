<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, as the other apps have them: each setting its title, a line on what it does,
     and its choices as pills. Up and down go from setting to setting. -->
<component name="SettingsScreen" extends="Group">
  <interface>
    <field id="route" type="assocarray" onChange="build" />
    <field id="go" type="assocarray" alwaysNotify="true" />
    <field id="menu" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="focusIn" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/SettingsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Fonts.brs" />
  <children>
    <Rectangle id="clip" width="1920" height="950" color="0x00000000" clippingRect="[0, 0, 1920, 950]">
      <Group id="body" translation="[96, 0]" />
    </Rectangle>
  </children>
</component>
