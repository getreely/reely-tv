<?xml version="1.0" encoding="utf-8"?>
<!-- Settings as the other apps lay them out: the sections down the left, each shown as the
     cursor reaches it, and its settings on the right, in groups. A setting with several
     values opens the list of them from the right; one that's on or off is a switch. -->
<component name="SettingsScreen" extends="Group">
  <interface>
    <field id="route" type="assocarray" onChange="build" />
    <field id="go" type="assocarray" alwaysNotify="true" />
    <field id="menu" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="focusIn" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/SettingsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/plex.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/extras.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/components/parts/Listen.brs" />
  <children>
    <Group id="rail" translation="[96, 6]">
      <Label id="heading" text="Settings" color="0xF2F4F7FF" />
      <Group id="sections" translation="[0, 84]" />
    </Group>
    <Rectangle id="clip" translation="[456, 0]" width="1380" height="950" color="0x00000000" clippingRect="[0, 0, 1380, 950]">
      <Group id="page" />
    </Rectangle>
  </children>
</component>
