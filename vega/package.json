{
  "name": "reely-vega",
  "private": true,
  "version": "0.57.28",
  "description": "Reely for Fire TV on Vega OS: the LG app's page in a WebView, in a small React Native shell.",
  "scripts": {
    "web": "node scripts/bundle-web.mjs",
    "build:debug": "npm run web && react-native build-vega --build-type Debug",
    "build:release": "npm run web && react-native build-vega --build-type Release",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "device:install": "vega device install-app --dir . -b Release",
    "device:launch": "vega device launch-app --dir ."
  },
  "dependencies": {
    "@amazon-devices/kepler-performance-api": "^0.1.4",
    "@amazon-devices/react-native-kepler": "2.0.1759135970",
    "@amazon-devices/webview": "~3.5.11",
    "react": "18.2.0",
    "react-native": "0.72.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0.22.14",
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "^11.3.2",
    "@react-native/metro-config": "^0.72.6",
    "@types/react": "^18.2.6",
    "metro-react-native-babel-preset": "^0.76.8",
    "typescript": "4.8.4"
  },
  "kepler": {
    "projectType": "application",
    "appName": "Reely",
    "targets": ["tv"],
    "os": ["vega"],
    "api": 0.1
  }
}
