{
  "name": "reely-vega",
  "private": true,
  "version": "0.58.33",
  "description": "Reely for Fire TV on Vega OS: its own React Native app, with Amazon's native video player.",
  "scripts": {
    "hls": "bash scripts/hlsjs.sh",
    "build:debug": "npm run hls && react-native build-vega --build-type Debug",
    "build:release": "npm run hls && react-native build-vega --build-type Release",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "device:install": "vega device install-app --dir . -b Release",
    "device:launch": "vega device launch-app --dir ."
  },
  "dependencies": {
    "@amazon-devices/react-native-async-storage__async-storage": "~2.1.0",
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-svg": "~3.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "@xmldom/xmldom": "^0.8.10",
    "base-64": "1.0.0",
    "fastestsmallesttextencoderdecoder": "1.0.22",
    "qrcode-generator": "^1.4.4",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "whatwg-url-without-unicode": "^8.0.0-3"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "kepler": {
    "projectType": "application",
    "appName": "Reely",
    "targets": [
      "tv"
    ]
  }
}
